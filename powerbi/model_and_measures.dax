/*
Model setup
Rename online_retail_clean to FactRetail after loading it into Power BI.
Create a calculated sales_date column to relate invoice timestamps to DimDate:

sales_date =
DATE(YEAR(FactRetail[invoice_date]), MONTH(FactRetail[invoice_date]), DAY(FactRetail[invoice_date]))

Create DimDate as a calculated table, mark DimDate[Date] as the date column,
and create a one-to-many relationship from DimDate[Date] to FactRetail[sales_date].
Create DimProduct from distinct merchandise stock codes and DimCustomer from
distinct nonblank customer IDs; relate each dimension to FactRetail.
*/

DimDate =
VAR FirstDate = MINX(ALL(FactRetail), FactRetail[sales_date])
VAR LastDate = MAXX(ALL(FactRetail), FactRetail[sales_date])
RETURN
    ADDCOLUMNS(
        CALENDAR(DATE(YEAR(FirstDate), 1, 1), DATE(YEAR(LastDate), 12, 31)),
        "Year", YEAR([Date]),
        "Month Number", MONTH([Date]),
        "Month", FORMAT([Date], "MMM"),
        "Month Start", DATE(YEAR([Date]), MONTH([Date]), 1),
        "Year Month", FORMAT([Date], "YYYY-MM"),
        "Is Partial Month", YEAR([Date]) = 2011 && MONTH([Date]) = 12
    )

DimProduct =
ADDCOLUMNS(
    FILTER(
        VALUES(FactRetail[stock_code]),
        NOT ISBLANK(FactRetail[stock_code])
            && CALCULATE(MAX(FactRetail[is_non_product])) = 0
    ),
    "Description", CALCULATE(FIRSTNONBLANK(FactRetail[description], 1))
)

DimCustomer =
FILTER(
    DISTINCT(SELECTCOLUMNS(FactRetail, "customer_id", FactRetail[customer_id])),
    NOT ISBLANK([customer_id])
)

Gross Revenue =
CALCULATE(
    SUM(FactRetail[line_revenue]),
    FactRetail[is_cancellation] = 0,
    FactRetail[is_non_product] = 0,
    FactRetail[quantity] > 0,
    FactRetail[price] > 0
)

Cancelled Value =
CALCULATE(
    SUMX(FactRetail, ABS(FactRetail[line_revenue])),
    FactRetail[is_cancellation] = 1
)

Net Revenue =
[Gross Revenue] - [Cancelled Value]

Orders =
CALCULATE(
    DISTINCTCOUNT(FactRetail[invoice]),
    FactRetail[is_cancellation] = 0,
    FactRetail[is_non_product] = 0,
    FactRetail[quantity] > 0,
    FactRetail[price] > 0
)

Average Order Value =
DIVIDE([Gross Revenue], [Orders])

Cancelled Invoices =
CALCULATE(
    DISTINCTCOUNT(FactRetail[invoice]),
    FactRetail[is_cancellation] = 1
)

All Invoices =
DISTINCTCOUNT(FactRetail[invoice])

Cancellation Rate =
DIVIDE([Cancelled Invoices], [All Invoices])

Registered Customers =
CALCULATE(
    DISTINCTCOUNT(FactRetail[customer_id]),
    FactRetail[is_cancellation] = 0,
    FactRetail[is_non_product] = 0,
    FactRetail[quantity] > 0,
    FactRetail[price] > 0,
    NOT ISBLANK(FactRetail[customer_id])
)

Repeat Customer Rate =
VAR CustomerOrderCounts =
    SUMMARIZE(
        FILTER(
            FactRetail,
            FactRetail[is_cancellation] = 0
                && FactRetail[is_non_product] = 0
                && FactRetail[quantity] > 0
                && FactRetail[price] > 0
                && NOT ISBLANK(FactRetail[customer_id])
        ),
        FactRetail[customer_id],
        "Order Count", CALCULATE(DISTINCTCOUNT(FactRetail[invoice]))
    )
VAR RepeatCustomers =
    COUNTROWS(FILTER(CustomerOrderCounts, [Order Count] >= 2))
RETURN
    DIVIDE(RepeatCustomers, COUNTROWS(CustomerOrderCounts))

Guest Revenue Share =
DIVIDE(
    CALCULATE([Gross Revenue], FactRetail[is_guest] = 1),
    [Gross Revenue]
)

Monthly Trend Revenue =
CALCULATE(
    [Gross Revenue],
    KEEPFILTERS('DimDate'[Is Partial Month] = FALSE())
)

Revenue MoM Percent =
VAR CurrentRevenue = [Monthly Trend Revenue]
VAR PreviousRevenue =
    CALCULATE(
        [Monthly Trend Revenue],
        DATEADD('DimDate'[Date], -1, MONTH)
    )
RETURN
    DIVIDE(CurrentRevenue - PreviousRevenue, PreviousRevenue)

Revenue YoY Percent =
VAR CurrentRevenue = [Monthly Trend Revenue]
VAR PreviousYearRevenue =
    CALCULATE(
        [Monthly Trend Revenue],
        DATEADD('DimDate'[Date], -1, YEAR)
    )
RETURN
    DIVIDE(CurrentRevenue - PreviousYearRevenue, PreviousYearRevenue)
